      "risk": 3,
      "reason": "Creates a new job from an existing one",
      "operation": "copy_job",
      "parameters": {
        "type": "object",
        "properties": {"source": {"type": "string"}, "name": {"type": "string"}, "folder": {"type": "string"}},
        "required": ["source", "name"],
        "additionalProperties": false
      }
    },

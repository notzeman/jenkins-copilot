{
  "tools": [
    {
      "name": "list_jobs",
      "description": "List Jenkins jobs visible to the current user. Use this to discover job names before inspecting builds. Results are filtered by Jenkins permissions.",
      "risk": 1,
      "reason": "Read-only job inventory",
      "operation": "list_jobs",
      "parameters": {
        "type": "object",
        "properties": {
          "folder": {"type": "string", "description": "Optional folder full name"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 500}
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_job_info",
      "description": "Get a job's type, health, last builds, parameters, and pipeline definition kind.",
      "risk": 1,
      "reason": "Read-only job metadata",
      "operation": "get_job_info",
      "parameters": {
        "type": "object",
        "properties": {"job": {"type": "string", "description": "Job full name including folders"}},
        "required": ["job"],
        "additionalProperties": false
      }
    },
    {
      "name": "get_job_config",
      "description": "Read the job config.xml. Sensitive-looking values are redacted. Requires Item/ExtendedRead.",
      "risk": 1,
      "reason": "Read-only job configuration",
      "operation": "get_job_config",
      "parameters": {
        "type": "object",
        "properties": {"job": {"type": "string"}},
        "required": ["job"],
        "additionalProperties": false
      }
    },
    {
      "name": "create_job",
      "description": "Create a Pipeline or Freestyle job. For Pipeline jobs provide a validated Jenkinsfile. Privileged.",
      "risk": 3,
      "reason": "Creates a Jenkins job",
      "operation": "create_job",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "folder": {"type": "string"},
          "type": {"type": "string", "enum": ["pipeline", "freestyle"]},
          "description": {"type": "string"},
          "jenkinsfile": {"type": "string"},
          "sandbox": {"type": "boolean"}
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    {
      "name": "copy_job",
